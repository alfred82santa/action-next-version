{
  "name": "action-next-version",
  "description": "Action Next Version",
  "version": "1.5.0",
  "author": "Alfred Santacatalina<alfred82santa@gmail.com>",
  "private": false,
  "homepage": "https://github.com/alfred82santa/action-next-version",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfred82santa/action-next-version.git"
  },
  "bugs": {
    "url": "https://github.com/alfred82santa/action-next-version/issues"
  },
  "keywords": [
    "actions",
    "node",
    "version",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint . -c ./.github/linters/eslint.config.mjs",
    "package": "npx ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:watch": "npm run package -- --watch",
    "test": "npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "AGPL-3.0-only",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@actions/([^/]+)$": "<rootDir>/node_modules/@actions/$1",
      "^@actions/([^/]+)/(.+)$": "<rootDir>/node_modules/@actions/$1/$2"
    },
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@actions|@octokit|before-after-hook|universal-user-agent|content-type|json-with-bigint)/)"
    ],
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@eslint/config-array": "^0.23.5",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@eslint/object-schema": "^3.0.5",
    "@renovatebot/pep440": "^4.2.4",
    "globals": "^17.12.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
